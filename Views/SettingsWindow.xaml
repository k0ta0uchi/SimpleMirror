<Window x:Class="SimpleMirror.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleMirror 設定" 
        Icon="pack://application:,,,/Assets/app.ico"
        Height="640" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <!-- macOS Style Modal Frame with Continuous Curve & Drop Shadow -->
    <Border Background="{StaticResource BrushBgDeep}"
            BorderBrush="{StaticResource BrushSpecularBorder}"
            BorderThickness="1"
            CornerRadius="16"
            Effect="{StaticResource AppleWindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- macOS Style Modal Header -->
            <Border Grid.Row="0" Background="{StaticResource BrushBgElevated}" CornerRadius="16,16,0,0" Padding="20,0"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Settings Gear Icon Badge -->
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,10,0">
                            <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81C14.36,2.58,14.16,2.4,13.92,2.4 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                                  Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="環境設定" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Close_Click" ToolTip="閉じる">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Settings Content (Apple Form Layout) -->
            <ScrollViewer Grid.Row="1" Margin="22,14,22,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. Performance Profile Section -->
                    <TextBlock Text="動作プロファイル" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4"/>
                    <TextBlock Text="用途に合わせて遅延と解像度のバランスを最適化します。" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"/>

                    <!-- Profile Cards Stack -->
                    <StackPanel Margin="0,0,0,18">
                        <!-- Ultra Low Latency Profile Card -->
                        <Border Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <RadioButton IsChecked="{Binding IsPerformanceProfile}" GroupName="ProfileGroup" VerticalContentAlignment="Center">
                                <StackPanel Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ 超低遅延 / パフォーマンス" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <Border Background="#26FF9F0A" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="音ゲー・アクション推奨" FontSize="10" Foreground="{StaticResource BrushWarning}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="60fps / 垂直同期待機スキップ（-vsync no）。iPhoneのダウンスケール負荷を排除し、滑らかさと超低遅延を両立。" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- Balanced Profile Card -->
                        <Border Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <RadioButton IsChecked="{Binding IsBalancedProfile}" GroupName="ProfileGroup" VerticalContentAlignment="Center">
                                <StackPanel Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚖️ 標準 / バランス（デフォルト）" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <Border Background="#260A84FF" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="おすすめ" FontSize="10" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="1080p @ 60fps / 標準バッファ。文字の視認性と滑らかさ、低遅延のベストバランス。" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- High Quality Profile Card -->
                        <Border Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <RadioButton IsChecked="{Binding IsQualityProfile}" GroupName="ProfileGroup" VerticalContentAlignment="Center">
                                <StackPanel Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💎 高画質 / クオリティ" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <Border Background="#26BF5AF2" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="写真・映画鑑賞向け" FontSize="10" Foreground="{StaticResource BrushPurple}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="1440p (2K) @ 60fps / 高品質カラー補間。最高峰の高精細グラフィックで描画。" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </StackPanel>

                    <!-- 2. Connection Settings Section -->
                    <TextBlock Text="接続設定" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushAccent}" Margin="0,4,0,12"/>

                    <TextBlock Text="AirPlay サーバー名 (iPhone上に表示)" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="ポート番号 (デフォルト: 7000)" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,0,0,18"/>

                    <!-- 3. System Options (Apple Toggle Switches) -->
                    <TextBlock Text="表示・機能オプション" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushAccent}" Margin="0,4,0,12"/>

                    <Border Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,18">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding KeepAspectRatio}" Content="アスペクト比を常に維持する" Style="{StaticResource AppleToggleSwitch}"/>
                            <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,4"/>
                            <CheckBox IsChecked="{Binding EnableAudio}" Content="iPhoneの音声をPCで再生する" Style="{StaticResource AppleToggleSwitch}"/>
                            <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,4"/>
                            <CheckBox IsChecked="{Binding EnableAutoOrientation}" Content="iPhoneの向きに合わせて自動で回転する (自動回転)" Style="{StaticResource AppleToggleSwitch}"/>
                            <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,4"/>
                            <CheckBox IsChecked="{Binding AutoStartServer}" Content="起動時に自動で待機を開始する" Style="{StaticResource AppleToggleSwitch}"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Screenshot Settings -->
                    <TextBlock Text="スクリーンショット設定" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushAccent}" Margin="0,4,0,12"/>

                    <TextBlock Text="保存先フォルダー" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ScreenshotDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Command="{Binding BrowseDirectoryCommand}" Content="参照..." Style="{StaticResource SecondaryButton}"/>
                    </Grid>

                    <Border Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,8">
                        <CheckBox IsChecked="{Binding CopyScreenshotToClipboard}" Content="撮影時にクリップボードへ自動コピー" Style="{StaticResource AppleToggleSwitch}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Footer (macOS Bar) -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgElevated}" CornerRadius="0,0,16,16" Padding="20,12"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                <Grid>
                    <Button Content="初期値に戻す" Command="{Binding ResetDefaultsCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="キャンセル" Style="{StaticResource SecondaryButton}" Click="Close_Click" Margin="0,0,10,0"/>
                        <Button Content="保存して適用" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
